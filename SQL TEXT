
--This enables foreign key constraints in SQLite, which is necessary for the REFERENCES clauses to work properly.
PRAGMA foreign_keys = ON;

--Drops the tables if they already exist to ensure a clean slate for the rest of the script.
--The order of dropping is important due to foreign key constraints.
drop table if exists projectGroup_student;
drop table if exists student_activity;
drop table if exists projectGroups;
drop table if exists students;
drop table if exists activities;

--Creates the necessary tables
CREATE TABLE IF NOT EXISTS students
(
    student_name TEXT PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS activities(
    activity_name TEXT PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS projectGroups(
    project_title TEXT PRIMARY KEY,
    supervisor_name TEXT,
    activity_name TEXT REFERENCES activities(activity_name)
);

CREATE TABLE IF NOT EXISTS student_activity(
    student_name TEXT REFERENCES students(student_name) NOT NULL ,
    activity_name TEXT REFERENCES activities(activity_name) NOT NULL
);

CREATE TABLE IF NOT EXISTS projectGroup_student(
    student_name TEXT REFERENCES students(student_name) NOT NULL,
    project_title TEXT REFERENCES projectGroups(project_title) NOT NULL
);

