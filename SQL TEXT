--lists the number of students for each project activity
SELECT a.activity_name, COUNT(sa.student_name) FROM activities as a
    LEFT JOIN student_activity as sa
        ON a.activity_name = sa.activity_name
                               GROUP BY a.activity_name;

-- for each project activity, counts the number of students in project groups.
SELECT activity_name, COUNT(projectGroup_student.student_name) as student_count
FROM projectGroups
    LEFT JOIN projectGroup_student
        ON projectGroups.project_title = projectGroup_student.project_title
GROUP BY projectGroups.activity_name;

